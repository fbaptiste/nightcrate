{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NightCrate",
  "version": "../../../frontend/package.json",
  "identifier": "io.github.fbaptiste.nightcrate",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "resources": {
      "../../build/backend/": "backend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4Q0FGNTQ2QkU1QThGQTYKUldTbWoxcStSdlhLQ0g0TU9Ya1NtYWlHTEl2blNSNEdEQzkxQmNxY2tvUXBYaXd5cXpUN0NqMDgK",
      "endpoints": [
        "https://github.com/fbaptiste/nightcrate/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
